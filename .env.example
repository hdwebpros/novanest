# Google Cloud Service Account credentials
NUXT_GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
NUXT_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Drive folder ID containing property subfolders
NUXT_GOOGLE_PROPERTIES_FOLDER_ID=your-drive-folder-id
